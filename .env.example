# Pluto runs checkout for this store. Do not commit real credentials.
# Production: https://pluto.afterhours.foundation with the live sale's installation key.
# Preview and local: a test-mode Pluto deployment with the test sale's installation key.
PLUTO_API_URL=
PLUTO_API_KEY=
# Optional. Vercel protection bypass secret for a protected Pluto preview deployment.
PLUTO_PROTECTION_BYPASS=

# Confirmation email webhook (live). The Stripe key only reads Checkout Sessions and line items.
STRIPE_RESTRICTED_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
BLOB_READ_WRITE_TOKEN=

# "Notify me" sign-up list.
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Optional trusted store origin for local development.
APP_ORIGIN=http://localhost:4321
