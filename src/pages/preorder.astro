---
import "../styles/preorder.css";
import "../styles/cart.css";
import Layout from "../components/layout.astro";
import PriceData from "../components/PriceData.astro";
import { getPriceAmounts } from "../scripts/stripe-prices";

const prices = await getPriceAmounts();
const returning = Astro.url.searchParams.has("session_id");
Astro.response.headers.set("Cache-Control", "private, no-store");
Astro.response.headers.set("Referrer-Policy", "no-referrer");
---

<Layout
    title="Preorder"
    description="Preorder merch from Afterhours Foundation for pickup at Purdue."
    checkout
>
    <main class="preorder" aria-label="W2026 merch preorder">
        <section class="preorder__panel">
            <div class="preorder__shapes" aria-hidden="true">
                <div class="preorder__shapes-art">
                    <img
                        class="preorder__shape preorder__shape--orange"
                        data-node-id="10:195"
                        src="/preorder/shapes/orange.svg"
                        alt=""
                    />
                    <img
                        class="preorder__shape preorder__shape--arc"
                        data-node-id="10:196"
                        src="/preorder/shapes/arc.svg"
                        alt=""
                    />
                    <img
                        class="preorder__shape preorder__shape--shirt"
                        data-node-id="10:197"
                        src="/preorder/shapes/shirt.svg"
                        alt=""
                    />
                    <img
                        class="preorder__shape preorder__shape--teal"
                        data-node-id="10:199"
                        src="/preorder/shapes/teal.svg"
                        alt=""
                    />
                    <img
                        class="preorder__shape preorder__shape--purple"
                        data-node-id="10:202"
                        src="/preorder/shapes/purple.svg"
                        alt=""
                    />
                    <span
                        class="preorder__shape preorder__shape--red"
                        data-node-id="10:205"
                    ></span>
                    <img
                        class="preorder__shape preorder__shape--star"
                        data-node-id="10:207"
                        src="/preorder/shapes/star.svg"
                        alt=""
                    />
                </div>
            </div>
            <form class="preorder__form" method="post" hidden={returning}>
                <a class="preorder__back preorder__back--shop" href="/#shop">&larr; Back to the shop</a>
                <h1 class="preorder__heading">Your preorder</h1>
                <p class="preorder__pickup">Pick up at Purdue.</p>
                <div class="preorder__contact">
                    <label>
                        <span>Pickup name</span>
                        <input
                            name="name"
                            type="text"
                            autocomplete="name"
                            maxlength="200"
                            required
                        />
                    </label>
                    <label>
                        <span>Email</span>
                        <input
                            name="email"
                            type="email"
                            autocomplete="email"
                            maxlength="254"
                            required
                        />
                    </label>
                </div>
                <p class="preorder__empty" data-cart-empty hidden>
                    Your cart is empty. <a href="/#shop">Shop the drop</a>.
                </p>
                <ul class="preorder__summary" aria-label="your cart" tabindex="-1" data-cart-lines data-cart-focus></ul>
                <div class="preorder__total">
                    <span>Total (USD)</span>
                    <output data-preorder-total>—</output>
                </div>
                <p class="preorder__error" role="alert" data-preorder-error></p>
                <noscript>Enable JavaScript to check out.</noscript>
                <button class="preorder__next" type="submit" disabled>
                    Continue to payment
                </button>
            </form>
            <div class="preorder__checkout" hidden={!returning}>
                <button class="preorder__back" type="button" data-checkout-back hidden={returning}>
                    &larr; Edit preorder
                </button>
                {!returning && <h1 class="preorder__heading preorder__heading--payment" tabindex="-1">Payment</h1>}
                <p
                    class="preorder__checkout-message"
                    role="status"
                    data-checkout-message
                >{returning ? "Checking your payment…" : ""}</p>
                <a class="preorder__back" data-checkout-check hidden>Check payment status</a>
                {returning && <section class="paid-order" data-paid-order hidden aria-labelledby="paid-heading">
                    <img class="paid-order__frog" src="/preorder/keychain/frog.svg" width="112" height="85" alt="" />
                    <h1 class="preorder__heading" id="paid-heading" tabindex="-1">Preorder confirmed!</h1>
                    <p>Thank you from Afterhours Foundation.</p>
                    <ul class="paid-order__lines" aria-label="Items ordered" data-paid-lines hidden></ul>
                    <div class="paid-order__total" data-paid-total hidden>
                        <span>Total paid</span><strong></strong>
                    </div>
                    <p>Pick up at Purdue. Email <a href="mailto:help@afterhours.foundation">help@afterhours.foundation</a> for pickup details.</p>
                    <a class="preorder__back" href="/#shop">&larr; Back to the shop</a>
                </section>}
                <div id="checkout-form"></div>
            </div>
            <details class="preorder__notice">
                <summary>Pickup, refunds &amp; privacy</summary>
                <p>The Afterhours Foundation, Inc. sells this merch. Your statement shows <strong>AFTERHOURS FOUNDATION</strong>.</p>
                <p>Email <a href="mailto:help@afterhours.foundation">help@afterhours.foundation</a> before ordering if you need shipping or have pickup questions.
                    For cancellations, returns or refunds, email us from the address you used at checkout.</p>
                <p>Afterhours keeps your pickup name, email and order in Notion to arrange pickup and answer questions.
                    Resend emails your receipt. <a href="https://stripe.com/privacy">Stripe</a> handles your payment details.</p>
            </details>
            <script>
                import "../scripts/preorder";
            </script>
        </section>
        <div class="preorder__word-art" aria-hidden="true">
            <div class="preorder__word-art-inner">
                <span class="preorder__letter preorder__letter--p">
                    <span>P</span>
                </span>
                <span class="preorder__letter preorder__letter--o">
                    <span>O</span>
                </span>
                <span class="preorder__letter preorder__letter--r1">
                    <span>R</span>
                </span>
                <span class="preorder__letter preorder__letter--e1">
                    <span>E</span>
                </span>
                <span class="preorder__letter preorder__letter--r2">
                    <span>R</span>
                </span>
                <span class="preorder__letter preorder__letter--d">
                    <span>D</span>
                </span>
                <span class="preorder__letter preorder__letter--e2">
                    <span>E</span>
                </span>
                <span class="preorder__letter preorder__letter--r3">
                    <span>R</span>
                </span>
            </div>
        </div>
    <PriceData prices={prices} />
    </main>
</Layout>
