---
import { getSecret } from "astro:env/server";
import "../styles/preorder.css";
import "../styles/cart.css";
import Layout from "../components/layout.astro";
import PriceData from "../components/PriceData.astro";
import { getPriceAmounts } from "../scripts/stripe-prices";

const prices = await getPriceAmounts();
const returning = Astro.url.searchParams.has("session_id");
Astro.response.headers.set("Cache-Control", "private, no-store");
Astro.response.headers.set("Referrer-Policy", "no-referrer");
---

<Layout
    title="Preorder"
    description="Check out your Purdue Hackers merch preorder."
    noindex
>
    <main class="preorder" aria-label="W2026 merch preorder">
        <section class="preorder__panel">
            <div class="preorder__shapes" aria-hidden="true">
                <div class="preorder__shapes-art">
                    <img
                        class="preorder__shape preorder__shape--orange"
                        data-node-id="10:195"
                        src="/preorder/shapes/orange.svg"
                        alt=""
                    />
                    <img
                        class="preorder__shape preorder__shape--arc"
                        data-node-id="10:196"
                        src="/preorder/shapes/arc.svg"
                        alt=""
                    />
                    <img
                        class="preorder__shape preorder__shape--shirt"
                        data-node-id="10:197"
                        src="/preorder/shapes/shirt.svg"
                        alt=""
                    />
                    <img
                        class="preorder__shape preorder__shape--teal"
                        data-node-id="10:199"
                        src="/preorder/shapes/teal.svg"
                        alt=""
                    />
                    <img
                        class="preorder__shape preorder__shape--purple"
                        data-node-id="10:202"
                        src="/preorder/shapes/purple.svg"
                        alt=""
                    />
                    <span
                        class="preorder__shape preorder__shape--red"
                        data-node-id="10:205"
                    ></span>
                    <img
                        class="preorder__shape preorder__shape--star"
                        data-node-id="10:207"
                        src="/preorder/shapes/star.svg"
                        alt=""
                    />
                </div>
            </div>
            <div class="preorder__notice">
                <p>sold by The Afterhours Foundation, Inc. for pickup at Purdue.
                    your statement will show <strong>AFTERHOURS FOUNDATION</strong>.</p>
                <details>
                    <summary>pickup, refunds &amp; privacy</summary>
                    <p>for pickup timing or a shipping request, get in touch before you order.
                        for cancellations, returns or refunds, email <a href="mailto:phackers@purdue.edu">phackers@purdue.edu</a>
                        with the email address you used at checkout.</p>
                    <p>Afterhours uses your pickup name, email and order details to fulfill
                        your order and respond to requests. the pickup list is stored in Notion.
                        Stripe handles your payment details under its <a href="https://stripe.com/privacy">privacy policy</a>.</p>
                </details>
                {getSecret("VERCEL_ENV") !== "production" && <p>Sandbox checkout · test payments only</p>}
            </div>
            <form class="preorder__form" method="post" hidden={returning}>
                <a class="preorder__back preorder__back--shop" href="/#shop">&larr; back to the shop</a>
                <div class="preorder__contact">
                    <label>
                        <span>pickup name</span>
                        <input
                            name="name"
                            type="text"
                            autocomplete="name"
                            maxlength="200"
                            placeholder="wack hacker"
                            required
                        />
                    </label>
                    <label>
                        <span>email</span>
                        <input
                            name="email"
                            type="email"
                            autocomplete="email"
                            maxlength="254"
                            placeholder="wackhacker@gmail.com"
                            required
                        />
                    </label>
                </div>
                <p class="preorder__empty" data-cart-empty hidden>
                    your cart is empty. <a href="/#shop">pick something on the homepage</a>.
                </p>
                <ul class="preorder__summary" aria-label="your cart" tabindex="-1" data-cart-lines data-cart-focus></ul>
                <div class="preorder__total">
                    <span>total (USD)</span>
                    <output data-preorder-total>—</output>
                </div>
                <p class="preorder__error" role="alert" data-preorder-error></p>
                <noscript>enable JavaScript to check out.</noscript>
                <button class="preorder__next" type="submit" disabled>
                    next
                </button>
            </form>
            <div class="preorder__checkout" hidden={!returning}>
                <button class="preorder__back" type="button" data-checkout-back hidden={returning}>
                    &larr; back
                </button>
                <p
                    class="preorder__checkout-message"
                    role="status"
                    data-checkout-message
                >{returning ? "checking your payment…" : ""}</p>
                <a class="preorder__back" data-checkout-check hidden>check payment status</a>
                <div id="checkout-form"></div>
            </div>
            <script>
                import "../scripts/preorder";
                import "../scripts/preorder-checkout";
            </script>
        </section>
        <div class="preorder__word-art" aria-hidden="true">
            <div class="preorder__word-art-inner">
                <span class="preorder__letter preorder__letter--p">
                    <span>P</span>
                </span>
                <span class="preorder__letter preorder__letter--o">
                    <span>O</span>
                </span>
                <span class="preorder__letter preorder__letter--r1">
                    <span>R</span>
                </span>
                <span class="preorder__letter preorder__letter--e1">
                    <span>E</span>
                </span>
                <span class="preorder__letter preorder__letter--r2">
                    <span>R</span>
                </span>
                <span class="preorder__letter preorder__letter--d">
                    <span>D</span>
                </span>
                <span class="preorder__letter preorder__letter--e2">
                    <span>E</span>
                </span>
                <span class="preorder__letter preorder__letter--r3">
                    <span>R</span>
                </span>
            </div>
        </div>
    <PriceData prices={prices} />
    </main>
</Layout>
