---
import Layout from "../components/layout.astro";
import { Image } from "astro:assets";
import hoodie1 from "../assets/hoodie1.jpg";
import hoodie2 from "../assets/hoodie2.jpg";
import hoodie3 from "../assets/hoodie3.jpg";
import hoodie4 from "../assets/hoodie4.jpg";
import "../styles/archive.css";
---

<Layout>
    <section class="archive-navbar">
        <h1>Archive</h1>
    </section>
    <section class="archive-content">
        <div class="archive-container">
            <Image src={hoodie1} alt=" " class="image one"/>
            <Image src={hoodie2} alt=" " class="image two"/>
            <Image src={hoodie3} alt=" " class="image three"/>
            <Image src={hoodie4} alt=" " class="image four"/>
        </div>
    </section>
</Layout>
