---
import Layout from "../components/layout.astro";
import hoodieFront from "../assets/hoodie-front.webp";
import hoodieBack from "../assets/hoodie-back.webp";
import hoodie1 from "../assets/hoodie1.webp";
import hoodie2 from "../assets/hoodie2.webp";
import hoodie3 from "../assets/hoodie3.webp";
import hoodie4 from "../assets/hoodie4.webp";
import hoodie5 from "../assets/hoodie5.webp";
import hoodie6 from "../assets/hoodie6.webp";
import hoodie7 from "../assets/hoodie7.webp";
import hoodie8 from "../assets/hoodie8.webp";
import archiveRed from "../assets/archive-red.svg";
import archiveUnion from "../assets/archive-union.svg";
import archiveStar from "../assets/archive-star.svg";
import archiveEllipse from "../assets/archive-ellipse.svg";
import "../styles/archive.css";

const hoodies = [
  { src: hoodie1.src, alt: "Creatura hoodie photo 1" },
  { src: hoodie2.src, alt: "Creatura hoodie photo 2" },
  { src: hoodie3.src, alt: "Creatura hoodie photo 3" },
  { src: hoodie4.src, alt: "Creatura hoodie photo 4" },
  { src: hoodie5.src, alt: "Creatura hoodie photo 5" },
  { src: hoodie6.src, alt: "Creatura hoodie photo 6" },
  { src: hoodie7.src, alt: "Creatura hoodie photo 7" },
  { src: hoodie8.src, alt: "Creatura hoodie photo 8" },
];
---

<Layout>
  <main class="archive-page">
    <a class="archive-back" href="/">back</a>

    <button class="hoodie-card" type="button" data-open-hoodie aria-haspopup="dialog" aria-controls="hoodie-overlay" aria-label="View the Creatura hoodie">
      <img class="hoodie-card__image hoodie-card__image--front" src={hoodieFront.src} alt="" />
      <img class="hoodie-card__image hoodie-card__image--back" src={hoodieBack.src} alt="" />
    </button>

    <dialog class="hoodie-overlay" id="hoodie-overlay" aria-labelledby="hoodie-title" aria-describedby="hoodie-description">
      <div class="hoodie-overlay__decor" aria-hidden="true">
        <img class="hoodie-overlay__shape hoodie-overlay__shape--red" src={archiveRed.src} alt="" />
        <img class="hoodie-overlay__shape hoodie-overlay__shape--green" src={archiveUnion.src} alt="" />
        <img class="hoodie-overlay__shape hoodie-overlay__shape--orange" src={archiveStar.src} alt="" />
        <img class="hoodie-overlay__shape hoodie-overlay__shape--blue" src={archiveEllipse.src} alt="" />
      </div>
      <div class="hoodie-overlay__surface" aria-hidden="true"></div>
      <div class="hoodie-overlay__handle" aria-hidden="true"></div>

      <p class="hoodie-overlay__description" id="hoodie-description" style="font-weight: normal;">
        a heavyweight stonewashed hoodie made to keep you warm during late nights.<br /><br />
        features ascii purdue hackers logo and purdue hackers creaturas, our community submitted mascots.
      </p>
      <div class="hoodie-overlay__bottom-copy">
        <p class="hoodie-overlay__season">spring 2026</p>
        <h1 class="hoodie-overlay__title" id="hoodie-title"><span>CREATURA</span><span>HOODIE</span></h1>
      </div>

      <section class="hoodie-carousel" aria-label="Hoodie photos">
        <div class="hoodie-carousel__main">
          <img data-carousel-current src={hoodies[0].src} alt={hoodies[0].alt} />
          <div class="hoodie-carousel__dots" aria-hidden="true">
            {hoodies.map((hoodie, index) => (
              <span
                class={`hoodie-carousel__dot${index === 0 ? " is-active" : ""}`}
                data-carousel-thumb
                data-image-src={hoodie.src}
                data-image-alt={hoodie.alt}
              ></span>
            ))}
          </div>
          <button class="hoodie-carousel__prev" type="button" data-carousel-prev aria-label="Previous hoodie photo"></button>
          <button class="hoodie-carousel__next" type="button" data-carousel-next aria-label="Next hoodie photo"></button>
        </div>
      </section>
    </dialog>
  </main>

  <script>
    import "../scripts/hoodie-overlay.ts";
  </script>
</Layout>
