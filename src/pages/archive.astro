---
/// <reference types="astro/client" />
import Layout from "../components/layout.astro";
import hoodieFront from "../assets/hoodie-front.webp";
import hoodieBack from "../assets/hoodie-back.webp";
import hoodie1 from "../assets/hoodie1.webp";
import hoodie2 from "../assets/hoodie2.webp";
import hoodie3 from "../assets/hoodie3.webp";
import hoodie4 from "../assets/hoodie4.webp";
import hoodie5 from "../assets/hoodie5.webp";
import hoodie6 from "../assets/hoodie6.webp";
import hoodie7 from "../assets/hoodie7.webp";
import hoodie8 from "../assets/hoodie8.webp";
import ItemOverlay from "../components/ItemOverlay.astro";
import "../styles/archive.css";

const hoodies = [
    { src: hoodie1.src, alt: "Creatura hoodie photo 1" },
    { src: hoodie2.src, alt: "Creatura hoodie photo 2" },
    { src: hoodie3.src, alt: "Creatura hoodie photo 3" },
    { src: hoodie4.src, alt: "Creatura hoodie photo 4" },
    { src: hoodie5.src, alt: "Creatura hoodie photo 5" },
    { src: hoodie6.src, alt: "Creatura hoodie photo 6" },
    { src: hoodie7.src, alt: "Creatura hoodie photo 7" },
    { src: hoodie8.src, alt: "Creatura hoodie photo 8" },
];
---

<Layout>
    <main class="archive-page">
        <a class="archive-back" href="/">
            back
        </a>

        <button
            class="hoodie-card"
            type="button"
            data-overlay-open="hoodie-overlay"
            aria-haspopup="dialog"
            aria-controls="hoodie-overlay"
            aria-label="View the Creatura hoodie"
        >
            <img
                class="hoodie-card__image hoodie-card__image--front"
                src={hoodieFront.src}
                alt=""
            />
            <img
                class="hoodie-card__image hoodie-card__image--back"
                src={hoodieBack.src}
                alt=""
            />
        </button>

        <ItemOverlay
            id="hoodie-overlay"
            as="h1"
            subject="hoodie"
            season="spring 2026"
            title={["CREATURA", "HOODIE"]}
            images={hoodies}
        >
            <p>
                a heavyweight stonewashed hoodie made to keep you warm during
                late nights.
                <br />
                <br />
                features ascii purdue hackers logo and purdue hackers creaturas,
                our community submitted mascots.
            </p>
        </ItemOverlay>
    </main>

    <script>
        import "../scripts/item-overlay";
    </script>
</Layout>
