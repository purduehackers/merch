---
import "../styles/hero.css";

const notifyEndpoint = import.meta.env.PUBLIC_NOTIFY_ENDPOINT || "/api/notify";

// Add a file path here when a product is ready; the placeholder disappears automatically.
const PRODUCT_DESIGNS: Record<string, string | null> = {
    socks: null,
    shirt: null,
    keychain: null,
    bag: null,
    cap: null,
};
---

<main class="home" aria-labelledby="page-title">
    <div class="home__stage">
        <canvas id="scene" aria-hidden="true"></canvas>
        <h1 id="page-title" class="sr-only">
            Merch
        </h1>
        <p class="home__descriptor">for the doers, makers, and dreamers</p>

        <a class="home__archive" href="/archive">
            archive
        </a>

        <div class="home__concept" aria-hidden="true">
            <img
                src="/assets/figma/merch-concept.png"
                alt=""
                width="323"
                height="1144"
                loading="eager"
                decoding="async"
            />
        </div>

        <form class="notify-form" data-endpoint={notifyEndpoint} novalidate>
            <label class="notify-form__prompt" for="notify-email">
                NOTIFY ME WHEN F2026 DROPS
            </label>
            <div class="notify-form__field">
                <input
                    id="notify-email"
                    name="email"
                    type="email"
                    autocomplete="email"
                    required
                />
            </div>
            <p class="notify-form__success" data-notify-success aria-live="polite" aria-atomic="true" hidden>
                <span style="--i: 0">you're</span>
                <span style="--i: 1">on</span>
                <span style="--i: 2">the</span>
                <span style="--i: 3">list</span>
            </p>
            <p class="notify-form__status" data-notify-status aria-live="polite" aria-atomic="true"></p>
        </form>

        <div class="items-background" aria-hidden="true"></div>
        <div class="lower-art">
            <div class="cutout-group">
                <div class="orbit-item orbit-item--socks">
                    <div class="shape shape--yellow" aria-hidden="true"><span></span></div>
                    <button class:list={["product", "product--other", PRODUCT_DESIGNS.socks && "product--ready"]} type="button" aria-label="Socks">
                        <div class="product__art"></div>
                        {PRODUCT_DESIGNS.socks && <img class="product__design" src={PRODUCT_DESIGNS.socks} alt="" />}
                        {!PRODUCT_DESIGNS.socks && <span class="product-question">?</span>}
                    </button>
                </div>
                <div class="orbit-item orbit-item--shirt">
                    <img class="shape shape--red-large" src="/assets/figma/ellipse-purple.svg" alt="" aria-hidden="true" width="348.778" height="348.778" loading="eager" decoding="async" />
                    <button class:list={["product", "product--shirt", PRODUCT_DESIGNS.shirt && "product--ready"]} type="button" aria-label="Shirt">
                        <div class="product__art"></div>
                        {PRODUCT_DESIGNS.shirt && <img class="product__design" src={PRODUCT_DESIGNS.shirt} alt="" />}
                        {!PRODUCT_DESIGNS.shirt && <span class="product-question">?</span>}
                    </button>
                </div>
                <div class="orbit-item orbit-item--keychain">
                    <div class="shape shape--keychain-ring" aria-hidden="true">
                        <div><img src="/assets/figma/ellipse-keychain.svg" alt="" width="410.708" height="205.354" loading="eager" decoding="async" /></div>
                    </div>
                    <button class:list={["product", "product--keychain", PRODUCT_DESIGNS.keychain && "product--ready"]} type="button" aria-label="Keychain">
                        <div class="product__art"></div>
                        {PRODUCT_DESIGNS.keychain && <img class="product__design" src={PRODUCT_DESIGNS.keychain} alt="" />}
                        {!PRODUCT_DESIGNS.keychain && <span class="product-question">?</span>}
                    </button>
                </div>
                <div class="orbit-item orbit-item--bag">
                    <div class="shape shape--green" aria-hidden="true">
                        <div><img src="/assets/figma/polygon-orange.svg" alt="" width="432.13" height="374.236" loading="eager" decoding="async" /></div>
                    </div>
                    <button class:list={["product", "product--bag", PRODUCT_DESIGNS.bag && "product--ready"]} type="button" aria-label="Bag">
                        <div class="product__art"></div>
                        {PRODUCT_DESIGNS.bag && <img class="product__design" src={PRODUCT_DESIGNS.bag} alt="" />}
                        {!PRODUCT_DESIGNS.bag && <span class="product-question">?</span>}
                    </button>
                </div>
                <div class="orbit-item orbit-item--cap">
                    <div class="shape shape--purple" aria-hidden="true">
                        <div><img src="/assets/figma/star-purple.svg" alt="" width="388.46" height="372.572" loading="eager" decoding="async" /></div>
                    </div>
                    <button class:list={["product", "product--cap", PRODUCT_DESIGNS.cap && "product--ready"]} type="button" aria-label="Cap">
                        <div class="product__art"></div>
                        {PRODUCT_DESIGNS.cap && <img class="product__design" src={PRODUCT_DESIGNS.cap} alt="" />}
                        {!PRODUCT_DESIGNS.cap && <span class="product-question">?</span>}
                    </button>
                </div>
            </div>
        </div>
    </div>
</main>

<script>
    import "../scripts/scene.ts";
    import "../scripts/notify.ts";
</script>
