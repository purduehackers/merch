# Pluto runs checkout for this store. Do not commit real credentials.
# PLUTO_API_KEY is the key of the sale's storefront app.
# Production: https://pluto.afterhours.foundation with the live sale's pluto_sk_live_ key.
# Preview and local: a test-mode Pluto deployment with the test sale's pluto_sk_test_ key.
# The former pluto_site_ installation key works until Pluto revokes it.
PLUTO_API_URL=
PLUTO_API_KEY=
# Signing secret (whsec_) of the storefront app's endpoint for /api/pluto-webhook.
PLUTO_WEBHOOK_SECRET=
# Optional. Vercel protection bypass secret for a protected Pluto preview deployment.
PLUTO_PROTECTION_BYPASS=

# Confirmation email (live). The Stripe key only reads Checkout Sessions and line items.
STRIPE_RESTRICTED_KEY=
# Stripe endpoint for /api/stripe-webhook. Remove it after the Pluto webhook delivers.
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
BLOB_READ_WRITE_TOKEN=

# "Notify me" sign-up list.
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Optional trusted store origin for local development.
APP_ORIGIN=http://localhost:4321
